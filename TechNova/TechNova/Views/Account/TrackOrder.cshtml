@model Order
@{
    ViewData["Title"] = "Track Order";
    var currentStage = Model.Status switch
    {
        OrderStatus.Pending => 0,
        OrderStatus.Processing => 1,
        OrderStatus.Shipped => 2,
        OrderStatus.Delivered => 3,
        _ => -1
    };
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h2 class="mb-1">Track Order</h2>
            <span class="text-muted">Order #@Model.OrderNumber</span>
        </div>
        <a asp-action="Orders" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to My Orders
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Current status: @Model.Status</h5>
        </div>
        <div class="card-body">
            @if (currentStage < 0)
            {
                <div class="alert alert-warning mb-4" role="alert">
                    This order is @Model.Status.ToString().ToLowerInvariant(). Shipment progress is no longer active.
                </div>
            }

            <div class="list-group mb-4">
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <i class="bi bi-check-circle-fill text-success me-2"></i>
                        Order placed
                    </div>
                    <span class="text-muted">@Model.OrderDate.ToString("MMM dd, yyyy")</span>
                </div>
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <i class="bi @(currentStage >= 1 ? "bi-check-circle-fill text-success" : "bi-circle text-muted") me-2"></i>
                        Processing
                    </div>
                    @if (currentStage >= 1)
                    {
                        <span class="text-success">Complete</span>
                    }
                    else if (currentStage == 0)
                    {
                        <span class="badge bg-warning text-dark">Current</span>
                    }
                    else
                    {
                        <span class="text-muted">Pending</span>
                    }
                </div>
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <i class="bi @(currentStage >= 2 ? "bi-check-circle-fill text-success" : "bi-circle text-muted") me-2"></i>
                        Shipped
                    </div>
                    @if (Model.ShippedDate.HasValue)
                    {
                        <span class="text-muted">@Model.ShippedDate.Value.ToString("MMM dd, yyyy")</span>
                    }
                    else if (currentStage == 2)
                    {
                        <span class="badge bg-primary">Current</span>
                    }
                    else
                    {
                        <span class="text-muted">Not shipped</span>
                    }
                </div>
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <i class="bi @(currentStage >= 3 ? "bi-check-circle-fill text-success" : "bi-circle text-muted") me-2"></i>
                        Delivered
                    </div>
                    @if (Model.DeliveredDate.HasValue)
                    {
                        <span class="text-muted">@Model.DeliveredDate.Value.ToString("MMM dd, yyyy")</span>
                    }
                    else if (currentStage == 3)
                    {
                        <span class="badge bg-success">Current</span>
                    }
                    else
                    {
                        <span class="text-muted">Not delivered</span>
                    }
                </div>
            </div>

            <p class="text-muted mb-0">
                <i class="bi bi-info-circle"></i>
                This page shows the status recorded by TechNova. Carrier tracking details are not available for this order.
            </p>
            <div class="d-flex flex-wrap gap-2 mt-3">
                <a asp-action="OrderDetails" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                    <i class="bi bi-receipt"></i> View Order Details
                </a>
                <a asp-action="DownloadInvoice" asp-route-id="@Model.Id" class="btn btn-primary">
                    <i class="bi bi-file-earmark-pdf"></i> Download Invoice (PDF)
                </a>
            </div>
        </div>
    </div>
</div>
