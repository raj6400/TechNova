@model TechNova.ViewModels.OrderConfirmationViewModel
@{
    ViewData["Title"] = "Order Confirmation";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <i class="bi bi-check-circle-fill text-success display-1"></i>
        <h2 class="mt-3">Thank you for your order!</h2>
        <p class="lead">@(Model.Order.PaymentStatus == TechNova.Models.PaymentStatus.Paid ? "Your payment was received successfully." : "Your order has been received. Payment is due on delivery.")</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-receipt"></i> Order Details</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h6>Order Information</h6>
                            <p class="mb-1"><strong>Order number:</strong> @Model.Order.OrderNumber</p>
                            <p class="mb-1"><strong>Order date:</strong> @Model.Order.OrderDate.ToString("MMM dd, yyyy HH:mm")</p>
                            <p class="mb-1"><strong>Status:</strong> @Model.Order.Status</p>
                            <p class="mb-0"><strong>Payment:</strong> @Model.Order.PaymentMethod (@Model.Order.PaymentStatus)</p>
                        </div>
                        <div class="col-md-6">
                            <h6>Shipping Address</h6>
                            <p class="mb-1">@Model.Order.ShippingAddress</p>
                            @if (!string.IsNullOrWhiteSpace(Model.Order.ShippingAddress2))
                            {
                                <p class="mb-1">@Model.Order.ShippingAddress2</p>
                            }
                            <p class="mb-1">@Model.Order.ShippingCity, @Model.Order.ShippingState @Model.Order.ShippingPostalCode</p>
                            <p class="mb-1">@Model.Order.ShippingCountry</p>
                            @if (!string.IsNullOrWhiteSpace(Model.Order.ShippingPhone))
                            {
                                <p class="mb-0"><strong>Phone:</strong> @Model.Order.ShippingPhone</p>
                            }
                        </div>
                    </div>

                    <h6>Order Items</h6>
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th class="text-center">Quantity</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderItems)
                                {
                                    <tr>
                                        <td>@item.Product?.Name</td>
                                        <td class="text-center">@item.Quantity</td>
                                        <td class="text-end">RS @item.UnitPrice.ToString("N0")</td>
                                        <td class="text-end">RS @item.TotalPrice.ToString("N0")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3" class="text-end"><strong>Subtotal:</strong></td>
                                    <td class="text-end">RS @Model.Order.Subtotal.ToString("N0")</td>
                                </tr>
                                <tr>
                                    <td colspan="3" class="text-end"><strong>Tax:</strong></td>
                                    <td class="text-end">RS @Model.Order.TaxAmount.ToString("N0")</td>
                                </tr>
                                <tr>
                                    <td colspan="3" class="text-end"><strong>Shipping:</strong></td>
                                    <td class="text-end">RS @Model.Order.ShippingCost.ToString("N0")</td>
                                </tr>
                                <tr class="table-primary">
                                    <td colspan="3" class="text-end"><strong>Total:</strong></td>
                                    <td class="text-end"><strong>RS @Model.Order.TotalAmount.ToString("N0")</strong></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Order.Notes))
                    {
                        <div class="alert alert-info mt-3 mb-0">
                            <strong>Order notes:</strong> @Model.Order.Notes
                        </div>
                    }
                </div>
            </div>

            <div class="text-center mt-4">
                <a asp-controller="Products" asp-action="Index" class="btn btn-primary btn-lg">
                    <i class="bi bi-shop"></i> Continue Shopping
                </a>
            </div>
        </div>
    </div>
</div>
