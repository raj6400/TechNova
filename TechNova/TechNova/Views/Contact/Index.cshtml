@model TechNova.Models.ContactMessage

@{
    ViewData["Title"] = "Contact Us";

    var contact = ViewBag.Contact as TechNova.Models.ContactInfo;
    var mapUrl = ViewBag.MapUrl as string;
}

<link rel="stylesheet" href="~/css/contact.css" asp-append-version="true" />

<section class="contact-hero">
    <div class="contact-hero-content">
        <span class="contact-label">GET IN TOUCH</span>
        <h1>Contact Us</h1>
        <p>
            Have a question or need assistance?
            We are always ready to help you.
        </p>
    </div>
</section>

<div class="contact-container">

    @if (TempData["Success"] != null)
    {
        <div class="contact-success">
            <i class="bi bi-check-circle-fill"></i>
            @TempData["Success"]
        </div>
    }

    <div class="contact-heading">
        <span>CONTACT INFORMATION</span>
        <h2>We'd Love to Hear From You</h2>
        <p>Reach out to our team using the details below.</p>
    </div>

    <div class="contact-info-grid">

        <div class="contact-info-card">
            <div class="contact-icon">
                <i class="bi bi-geo-alt-fill"></i>
            </div>
            <h3>Our Location</h3>
            <p>@contact?.Address</p>
        </div>

        <div class="contact-info-card">
            <div class="contact-icon">
                <i class="bi bi-telephone-fill"></i>
            </div>
            <h3>Phone Number</h3>
            <a href="tel:@contact?.Phone">
                @contact?.Phone
            </a>
        </div>

        <div class="contact-info-card">
            <div class="contact-icon">
                <i class="bi bi-envelope-fill"></i>
            </div>
            <h3>Email Address</h3>
            <a href="mailto:@contact?.Email">
                @contact?.Email
            </a>
        </div>

        <div class="contact-info-card">
            <div class="contact-icon">
                <i class="bi bi-clock-fill"></i>
            </div>
            <h3>Working Hours</h3>
            <p>@contact?.WorkingHours</p>
        </div>

    </div>

    <div class="contact-main-grid">

        <div class="contact-form-box">
            <span class="contact-label">SEND US A MESSAGE</span>
            <h2>Let's Talk</h2>

            <p>Fill out the form and our team will get back to you.</p>

            <form asp-controller="Contact"
                  asp-action="SendMessage"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger"></div>

                <div class="form-group">
                    <label asp-for="Name">Full Name</label>
                    <input asp-for="Name"
                           class="form-control"
                           placeholder="Enter your name" />
                    <span asp-validation-for="Name"
                          class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Email">Email Address</label>
                    <input asp-for="Email"
                           class="form-control"
                           placeholder="Enter your email" />
                    <span asp-validation-for="Email"
                          class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Phone">Phone Number</label>
                    <input asp-for="Phone"
                           class="form-control"
                           placeholder="Enter phone number" />
                    <span asp-validation-for="Phone"
                          class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Subject">Subject</label>
                    <input asp-for="Subject"
                           class="form-control"
                           placeholder="Enter subject" />
                    <span asp-validation-for="Subject"
                          class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Message">Your Message</label>
                    <textarea asp-for="Message"
                              class="form-control"
                              rows="5"
                              placeholder="Write your message here..."></textarea>
                    <span asp-validation-for="Message"
                          class="text-danger"></span>
                </div>

                <button type="submit" class="contact-submit">
                    Send Message
                    <i class="bi bi-arrow-right"></i>
                </button>

            </form>
        </div>

        <div class="contact-map-box">
            <span class="contact-label">FIND US</span>
            <h2>Our Location</h2>

            <div class="map-container">
                <iframe src="@mapUrl"
                        width="100%"
                        height="100%"
                        style="border:0;"
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                        allowfullscreen>
                </iframe>
            </div>

            <div class="map-address">
                <i class="bi bi-geo-alt-fill"></i>
                <span>@contact?.Address</span>
            </div>

            @if (!string.IsNullOrWhiteSpace(contact?.WhatsApp))
            {
                <a class="whatsapp-button"
                   href="https://wa.me/@System.Text.RegularExpressions.Regex.Replace(contact.WhatsApp, @"\D", "")"
                   target="_blank"
                   rel="noopener">
                    <i class="bi bi-whatsapp"></i>
                    Chat on WhatsApp
                </a>
            }
        </div>

    </div>

    <div class="contact-social">
        <h2>Connect With Us</h2>

        <div class="social-links">

            @if (!string.IsNullOrWhiteSpace(contact?.Facebook))
            {
                <a href="@contact.Facebook" target="_blank" rel="noopener">
                    <i class="bi bi-facebook"></i>
                </a>
            }

            @if (!string.IsNullOrWhiteSpace(contact?.Instagram))
            {
                <a href="@contact.Instagram" target="_blank" rel="noopener">
                    <i class="bi bi-instagram"></i>
                </a>
            }

            @if (!string.IsNullOrWhiteSpace(contact?.Twitter))
            {
                <a href="@contact.Twitter" target="_blank" rel="noopener">
                    <i class="bi bi-twitter-x"></i>
                </a>
            }

            @if (!string.IsNullOrWhiteSpace(contact?.LinkedIn))
            {
                <a href="@contact.LinkedIn" target="_blank" rel="noopener">
                    <i class="bi bi-linkedin"></i>
                </a>
            }

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}