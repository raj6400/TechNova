@model List<Order>
@using TechNova.Models
@{
    ViewData["Title"] = "Orders";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h3 mb-1">Orders</h1>
        <p class="text-muted mb-0">Search and review customer orders</p>
    </div>
</div>

@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}
@if (TempData["Error"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<section class="card dashboard-card mb-4">
    <div class="card-body">
        <form method="get" asp-area="Admin" asp-controller="Orders" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label for="search" class="form-label">Search</label>
                <input id="search" type="search" name="search" class="form-control" placeholder="Order number, customer, or email" value="@ViewBag.Search" />
            </div>
            <div class="col-md-4">
                <label for="status" class="form-label">Order status</label>
                <select id="status" name="status" class="form-select">
                    <option value="">All statuses</option>
                    @foreach (var orderStatus in ViewBag.Statuses)
                    {
                        <option value="@orderStatus" selected="@(ViewBag.CurrentStatus == orderStatus ? "selected" : null)">@orderStatus</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-search me-1"></i>Filter</button>
                <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="btn btn-outline-secondary">Clear</a>
            </div>
        </form>
    </div>
</section>

<section class="card dashboard-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Order</th>
                    <th>Customer</th>
                    <th>Items</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th>Payment</th>
                    <th>Date</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td class="text-center text-muted py-4" colspan="8">No orders match the selected filters.</td></tr>
                }
                else
                {
                    @foreach (var order in Model)
                    {
                        var statusClass = order.Status switch
                        {
                            OrderStatus.Pending => "text-bg-warning",
                            OrderStatus.Processing => "text-bg-info",
                            OrderStatus.Shipped => "text-bg-primary",
                            OrderStatus.Delivered => "text-bg-success",
                            OrderStatus.Cancelled or OrderStatus.Refunded => "text-bg-danger",
                            _ => "text-bg-secondary"
                        };
                        var paymentClass = order.PaymentStatus switch
                        {
                            PaymentStatus.Paid => "text-bg-success",
                            PaymentStatus.Failed or PaymentStatus.Refunded => "text-bg-danger",
                            _ => "text-bg-warning"
                        };
                        <tr>
                            <td class="fw-semibold">@order.OrderNumber</td>
                            <td>
                                <div>@order.CustomerFirstName @order.CustomerLastName</div>
                                <small class="text-muted">@order.CustomerEmail</small>
                            </td>
                            <td>@order.OrderItems.Count</td>
                            <td>Rs @order.TotalAmount.ToString("N0")</td>
                            <td><span class="badge @statusClass">@order.Status</span></td>
                            <td><span class="badge @paymentClass">@order.PaymentStatus</span></td>
                            <td>@order.OrderDate.ToString("MMM dd, yyyy HH:mm")</td>
                            <td class="text-end text-nowrap">
                                <a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary" aria-label="View order @order.OrderNumber" title="View order">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-area="Admin" asp-controller="Orders" asp-action="Invoice" asp-route-id="@order.Id" class="btn btn-sm btn-outline-secondary" aria-label="View invoice for @order.OrderNumber" title="View invoice">
                                    <i class="bi bi-receipt"></i>
                                </a>
                                <a asp-area="Admin" asp-controller="Orders" asp-action="InvoicePdf" asp-route-id="@order.Id" class="btn btn-sm btn-outline-secondary" aria-label="Download invoice for @order.OrderNumber" title="Download PDF">
                                    <i class="bi bi-file-earmark-pdf"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>

@if (ViewBag.TotalPages > 1)
{
    <nav class="mt-3" aria-label="Order pages">
        <ul class="pagination justify-content-center">
            @for (var pageNumber = 1; pageNumber <= (int)ViewBag.TotalPages; pageNumber++)
            {
                <li class="page-item @(pageNumber == (int)ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-area="Admin" asp-controller="Orders" asp-action="Index" asp-route-page="@pageNumber" asp-route-status="@ViewBag.CurrentStatus" asp-route-search="@ViewBag.Search" aria-current="@(pageNumber == (int)ViewBag.CurrentPage ? "page" : null)">@pageNumber</a>
                </li>
            }
        </ul>
    </nav>
}
