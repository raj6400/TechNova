@model TechNova.Models.Slider
@{
    ViewData["Title"] = "Add Slider";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h3><i class="bi bi-images"></i> Add Slider</h3>
    <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-4">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <partial name="_SliderForm" model="Model" />
            <div class="mt-4">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save Slider</button>
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
