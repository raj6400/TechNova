@model IReadOnlyList<TechNova.Models.Slider>
@{
    ViewData["Title"] = "Home Sliders";
    int max = ViewBag.MaxSliders;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h3><i class="bi bi-images"></i> Home Page Sliders</h3>
        <p class="text-muted mb-0">Manage the image slider shown on the Home page (@Model.Count / @max used).</p>
    </div>
    @if (Model.Count < max)
    {
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Slider</a>
    }
    else
    {
        <button class="btn btn-secondary" disabled>Maximum @max sliders reached</button>
    }
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Image</th>
                    <th>Title</th>
                    <th>Button</th>
                    <th>Order</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No sliders found. Click "Add Slider".</td></tr>
                }
                else
                {
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td><img src="@s.ImagePath" alt="@s.Title" class="slider-thumb" /></td>
                            <td>
                                <strong>@(string.IsNullOrWhiteSpace(s.Title) ? "—" : s.Title)</strong>
                                @if (!string.IsNullOrWhiteSpace(s.SubTitle))
                                {
                                    <div class="small text-muted text-truncate slider-sub">@s.SubTitle</div>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(s.ButtonText))
                                {
                                    <span class="badge text-bg-info">@s.ButtonText</span>
                                }
                                else
                                {

                                    <span>—</span>
                                }
                            </td>
                            <td>@s.DisplayOrder</td>
                            <td>
                                @if (s.IsActive)
                                {
                                    <span class="badge text-bg-success">Active</span>
                                }
                                else
                                {

                                    <span class="badge text-bg-secondary">Hidden</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="ToggleActive" asp-route-id="@s.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-warning" title="@(s.IsActive ? "Hide" : "Show")">
                                        <i class="bi @(s.IsActive ? "bi-eye-slash" : "bi-eye")"></i>
                                    </button>
                                </form>
                                <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this slider permanently?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Styles {
    <style>
        .slider-thumb { width: 140px; height: 70px; object-fit: cover; border-radius: .5rem; background: #f1f3f5; }
        .slider-sub { max-width: 260px; }
    </style>
}
