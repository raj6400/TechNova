@model TechNova.Models.Slider

<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" placeholder="Big headline on the slide" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="SubTitle" class="form-label"></label>
        <input asp-for="SubTitle" class="form-control" placeholder="Small text under headline" />
        <span asp-validation-for="SubTitle" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="ButtonText" class="form-label"></label>
        <input asp-for="ButtonText" class="form-control" placeholder="Shop Now" />
        <span asp-validation-for="ButtonText" class="text-danger"></span>
    </div>
    <div class="col-md-5">
        <label asp-for="ButtonLink" class="form-label"></label>
        <input asp-for="ButtonLink" class="form-control" placeholder="/Products" />
        <span asp-validation-for="ButtonLink" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="DisplayOrder" class="form-label"></label>
        <input asp-for="DisplayOrder" type="number" min="1" class="form-control" />
        <span asp-validation-for="DisplayOrder" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="ImageFile" class="form-label"></label>
        <input asp-for="ImageFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,.gif" id="sliderImageInput" />
        <div class="form-text">Recommended size: 1920 x 700 px. JPG / PNG / WEBP / GIF, max 5 MB.</div>
        <span asp-validation-for="ImageFile" class="text-danger"></span>
        <div class="mt-2">
            <img id="sliderPreview" src="@Model.ImagePath" alt="Preview"
                 style="max-width:100%; max-height:220px; border-radius:.5rem; @(string.IsNullOrEmpty(Model.ImagePath) ? "display:none;" : "")" />
        </div>
    </div>
    <div class="col-12 form-check ms-2">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label"></label>
    </div>
</div>

<script>
    document.getElementById('sliderImageInput').addEventListener('change', function() {
        var file = this.files[0];
        var img = document.getElementById('sliderPreview');
        if (file) {
            img.src = URL.createObjectURL(file);
            img.style.display = 'block';
        }
    });
</script>
