@using TechNova.Models
@model IReadOnlyList<Product>

@{
    ViewData["Title"] = "Products";

    var categories = ViewBag.Categories as IEnumerable<Category>
        ?? Enumerable.Empty<Category>();

    var brands = ViewBag.Brands as IEnumerable<Brand>
        ?? Enumerable.Empty<Brand>();

    var currentPage = (int?)ViewBag.CurrentPage ?? 1;
    var totalPages = (int?)ViewBag.TotalPages ?? 0;

    var search = ViewBag.Search as string;
    var selectedCategoryId = (int?)ViewBag.CategoryId;
    var selectedBrandId = (int?)ViewBag.BrandId;
}

<!-- Messages -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["Success"]
        <button type="button" class="btn-close"
                data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-circle me-2"></i>
        @TempData["Error"]
        <button type="button" class="btn-close"
                data-bs-dismiss="alert"></button>
    </div>
}

<!-- Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h3 class="mb-1">
            <i class="bi bi-phone"></i> Products
        </h3>
        <p class="text-muted mb-0">
            Search, filter and manage your TechNova products.
        </p>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="ExportToExcel"
           asp-route-search="@search"
           asp-route-categoryId="@selectedCategoryId"
           asp-route-brandId="@selectedBrandId"
           class="btn btn-success">
            <i class="bi bi-file-earmark-excel"></i> Export Excel
        </a>

        <button type="button"
                class="btn btn-info"
                data-bs-toggle="modal"
                data-bs-target="#importModal">
            <i class="bi bi-upload"></i> Import Excel
        </button>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Add Product
        </a>
    </div>
</div>

<!-- Import modal -->
<div class="modal fade" id="importModal" tabindex="-1" aria-labelledby="importModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="importModalLabel">Import Products</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-area="Admin"
                  asp-controller="Products"
                  asp-action="ImportFromExcel"
                  method="post"
                  enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <label for="productExcelFile" class="form-label">Select Excel file</label>
                    <input id="productExcelFile"
                           type="file"
                           name="file"
                           class="form-control"
                           accept=".xlsx"
                           required />
                    <small class="text-muted">
                        Use the <a asp-action="ExportToExcel">Excel template</a> to keep the column format aligned.
                    </small>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-upload"></i> Import
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Search and filters -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get"
              asp-area="Admin"
              asp-controller="Products"
              asp-action="Index">

            <div class="row g-2 align-items-end">

                <div class="col-lg-5">
                    <label class="form-label">Search Product</label>
                    <input type="search"
                           name="search"
                           value="@search"
                           class="form-control"
                           placeholder="Product name or model..." />
                </div>

                <div class="col-lg-3">
                    <label class="form-label">Category</label>

                    <select name="categoryId" class="form-select">
                        <option value="">All Categories</option>

                        @foreach (var category in categories)
                        {
                            <option value="@category.Id"
                                    selected="@(selectedCategoryId == category.Id)">
                                @category.Name
                            </option>
                        }
                    </select>
                </div>

                <div class="col-lg-3">
                    <label class="form-label">Brand</label>

                    <select name="brandId" class="form-select">
                        <option value="">All Brands</option>

                        @foreach (var brand in brands)
                        {
                            <option value="@brand.Id"
                                    selected="@(selectedBrandId == brand.Id)">
                                @brand.Name
                            </option>
                        }
                    </select>
                </div>

                <div class="col-lg-1">
                    <button type="submit"
                            class="btn btn-outline-primary w-100">
                        <i class="bi bi-search"></i>
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(search)
                    || selectedCategoryId.HasValue
                    || selectedBrandId.HasValue)
                {
                    <div class="col-12">
                        <a asp-action="Index"
                           class="text-decoration-none small">
                            <i class="bi bi-x-circle"></i> Clear filters
                        </a>
                    </div>
                }

            </div>
        </form>
    </div>
</div>

<!-- View Options -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <small class="text-muted">Display:</small>
    </div>
    <div class="btn-group" role="group" aria-label="View options">
        <input type="radio" class="btn-check" name="viewMode" id="tableView" value="table" checked>
        <label class="btn btn-outline-secondary btn-sm" for="tableView">
            <i class="bi bi-list-ul"></i> Table
        </label>

        <input type="radio" class="btn-check" name="viewMode" id="gridView" value="grid">
        <label class="btn btn-outline-secondary btn-sm" for="gridView">
            <i class="bi bi-grid-3x2-gap"></i> Grid
        </label>
    </div>
</div>

<!-- Product table -->
<div class="card shadow-sm" id="productContainer">

    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <strong>Product Catalog</strong>
        <span class="badge bg-primary">
            @Model.Count Products
        </span>
    </div>

    <div class="table-responsive">

        <table class="table table-hover align-middle mb-0">

            <thead class="table-dark">
                <tr>
                    <th>Image</th>
                    <th>Product</th>
                    <th>Brand</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Featured</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="9"
                            class="text-center py-5 text-muted">
                            <i class="bi bi-box-seam fs-1 d-block mb-2"></i>
                            No products found.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var product in Model)
                    {
                        <tr>

                            <td>
                                <img src="@(string.IsNullOrWhiteSpace(product.MainImageUrl)
                                                                    ? "/images/products/placeholder.jpg"
                                                                    : product.MainImageUrl)"
                                     alt="@product.Name"
                                     width="55"
                                     height="55"
                                     class="rounded"
                                     style="object-fit:cover;" />
                            </td>

                            <td>
                                <strong>@product.Name</strong>

                                @if (!string.IsNullOrWhiteSpace(product.Model))
                                {
                                    <small class="text-muted d-block">
                                        @product.Model
                                    </small>
                                }
                            </td>

                            <td>@product.Brand?.Name</td>

                            <td>@product.Category?.Name</td>

                            <td>
                                @if (product.OriginalPrice > product.SalePrice)
                                {
                                    <del class="text-muted small">
                                        ₹@product.OriginalPrice.ToString("N0")
                                    </del>
                                    <br />
                                }

                                <strong>
                                    ₹@product.SalePrice.ToString("N0")
                                </strong>
                            </td>

                            <td>
                                <span class="badge @(product.StockQuantity <= 10
                                                                        ? "bg-danger"
                                                                        : "bg-success")">
                                    @product.StockQuantity
                                </span>
                            </td>

                            <td>
                                @if (product.IsFeatured)
                                {
                                    <i class="bi bi-check-circle-fill text-success"></i>
                                }
                                else
                                {
                                    <i class="bi bi-x-circle text-muted"></i>
                                }
                            </td>

                            <td>
                                <span class="badge @(product.IsActive
                                                                        ? "bg-success"
                                                                        : "bg-secondary")">
                                    @(product.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>

                            <!-- ONLY ONE EDIT BUTTON -->
                            <td class="text-end">

                                <a asp-area="Admin"
                                   asp-controller="Products"
                                   asp-action="Details"
                                   asp-route-id="@product.Id"
                                   class="btn btn-sm btn-info"
                                   title="View Product Details">
                                    <i class="bi bi-eye"></i>
                                    View
                                </a>

                                <a asp-area="Admin"
                                   asp-controller="Products"
                                   asp-action="Edit"
                                   asp-route-id="@product.Id"
                                   class="btn btn-sm btn-primary"
                                   title="Edit Product">
                                    <i class="bi bi-pencil-square"></i>
                                    Edit
                                </a>

                                <form asp-area="Admin"
                                      asp-controller="Products"
                                      asp-action="Delete"
                                      asp-route-id="@product.Id"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Are you sure you want to delete this product?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger"
                                            title="Delete Product">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>

                            </td>
                        </tr>
                    }
                }

            </tbody>
        </table>
    </div>

    <!-- Grid View (hidden by default) -->
    <div class="card-body" id="gridViewContainer" style="display: none;">
        @if (Model.Count == 0)
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-box-seam fs-1 d-block mb-2"></i>
                No products found.
            </div>
        }
        else
        {
            <div class="row g-4" id="productsGrid">
                @foreach (var product in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 admin-product-card">
                            <div class="position-relative">
                                <img src="@(string.IsNullOrWhiteSpace(product.MainImageUrl)
                                                                    ? "/images/products/placeholder.jpg"
                                                                    : product.MainImageUrl)"
                                     alt="@product.Name"
                                     class="card-img-top"
                                     style="height: 200px; object-fit: contain; padding: 10px;" />
                                @if (product.IsFeatured)
                                {
                                    <span class="badge bg-success position-absolute top-0 end-0 m-2">Featured</span>
                                }
                            </div>
                            <div class="card-body">
                                <h6 class="card-title">@product.Name</h6>
                                @if (!string.IsNullOrWhiteSpace(product.Model))
                                {
                                    <small class="text-muted d-block mb-2">@product.Model</small>
                                }

                                <div class="mb-2">
                                    <div class="text-muted small">
                                        <div>Brand: <strong>@product.Brand?.Name</strong></div>
                                        <div>Category: <strong>@product.Category?.Name</strong></div>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div>
                                        @if (product.OriginalPrice > product.SalePrice)
                                        {
                                            <del class="text-muted small">₹@product.OriginalPrice.ToString("N0")</del>
                                            <br />
                                        }
                                        <strong class="text-primary">₹@product.SalePrice.ToString("N0")</strong>
                                    </div>
                                    <span class="badge @(product.StockQuantity <= 10 ? "bg-danger" : "bg-success")">
                                        @product.StockQuantity
                                    </span>
                                </div>

                                <div class="d-flex gap-2 flex-wrap">
                                    @if (!product.IsActive)
                                    {
                                        <span class="badge bg-secondary small">Inactive</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success small">Active</span>
                                    }
                                </div>
                            </div>
                            <div class="card-footer bg-white">
                                <a asp-area="Admin"
                                   asp-controller="Products"
                                   asp-action="Details"
                                   asp-route-id="@product.Id"
                                   class="btn btn-sm btn-info w-100 mb-2">
                                    <i class="bi bi-eye"></i> View
                                </a>
                                <a asp-area="Admin"
                                   asp-controller="Products"
                                   asp-action="Edit"
                                   asp-route-id="@product.Id"
                                   class="btn btn-sm btn-primary w-100 mb-2">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </a>
                                <form asp-area="Admin"
                                      asp-controller="Products"
                                      asp-action="Delete"
                                      asp-route-id="@product.Id"
                                      method="post"
                                      onsubmit="return confirm('Are you sure you want to delete this product?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

</div>

<!-- Pagination -->
@if (totalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">

            @for (var i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">

                    <a class="page-link"
                       asp-area="Admin"
                       asp-controller="Products"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-search="@search"
                       asp-route-categoryId="@selectedCategoryId"
                       asp-route-brandId="@selectedBrandId">
                        @i
                    </a>

                </li>
            }

        </ul>
    </nav>
}
