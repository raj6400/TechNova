@model List<TechNova.Models.ContactMessage>

@{
    ViewData["Title"] = "Customer Messages";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Customer Messages</h2>
            <p class="text-muted">
                Manage messages received from your Contact Us page.
            </p>
        </div>

        <a href="/Admin/ContactAdmin/Edit"
           class="btn btn-outline-primary">
            <i class="bi bi-gear"></i>
            Contact Settings
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Subject</th>
                            <th>Message</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            var count = 1;

                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@count</td>
                                    <td>@item.Name</td>
                                    <td>
                                        <a href="mailto:@item.Email">
                                            @item.Email
                                        </a>
                                    </td>
                                    <td>@item.Phone</td>
                                    <td>@item.Subject</td>
                                    <td style="min-width:200px">
                                        @item.Message
                                    </td>
                                    <td>
                                        @item.CreatedAt.ToLocalTime()
                                            .ToString("dd-MM-yyyy hh:mm tt")
                                    </td>
                                    <td>
                                        @if (item.IsRead)
                                        {
                                            <span class="badge bg-success">
                                                Read
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Unread
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex gap-2">

                                            @if (!item.IsRead)
                                            {
                                                <form asp-action="MarkAsRead"
                                                      asp-controller="ContactAdmin"
                                                      asp-area="Admin"
                                                      method="post">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@item.Id" />

                                                    <button type="submit"
                                                            class="btn btn-sm btn-success">
                                                        <i class="bi bi-check"></i>
                                                    </button>

                                                </form>
                                            }

                                            <form asp-action="DeleteMessage"
                                                  asp-controller="ContactAdmin"
                                                  asp-area="Admin"
                                                  method="post"
                                                  onsubmit="return confirm('Delete this message?');">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@item.Id" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-danger">
                                                    <i class="bi bi-trash"></i>
                                                </button>

                                            </form>

                                        </div>
                                    </td>
                                </tr>

                                count++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9"
                                    class="text-center py-5">
                                    <i class="bi bi-envelope-open fs-1 text-muted"></i>
                                    <p class="mt-2 mb-0">
                                        No customer messages found.
                                    </p>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>