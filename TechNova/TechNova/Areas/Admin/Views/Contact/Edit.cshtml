@model TechNova.Models.ContactInfo

@{
    ViewData["Title"] = "Manage Contact Details";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Manage Contact Details</h2>
            <p class="text-muted">
                Update information displayed on the Contact Us page.
            </p>
        </div>

        <a href="/Admin/ContactAdmin/Messages"
           class="btn btn-primary">
            <i class="bi bi-envelope"></i>
            Customer Messages
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-4">

            <form asp-controller="ContactAdmin"
                  asp-action="Edit"
                  asp-area="Admin"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <h5 class="mb-3">Basic Information</h5>

                <div asp-validation-summary="ModelOnly"
                     class="text-danger"></div>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="CompanyName"
                               class="form-label">Company Name</label>
                        <input asp-for="CompanyName"
                               class="form-control" />
                        <span asp-validation-for="CompanyName"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Phone"
                               class="form-label">Phone</label>
                        <input asp-for="Phone"
                               class="form-control" />
                        <span asp-validation-for="Phone"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Email"
                               class="form-label">Email</label>
                        <input asp-for="Email"
                               class="form-control" />
                        <span asp-validation-for="Email"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="WhatsApp"
                               class="form-label">WhatsApp Number</label>
                        <input asp-for="WhatsApp"
                               class="form-control" />
                    </div>

                    <div class="col-12 mb-3">
                        <label asp-for="Address"
                               class="form-label">Full Address</label>
                        <textarea asp-for="Address"
                                  class="form-control"
                                  rows="3"></textarea>
                        <span asp-validation-for="Address"
                              class="text-danger"></span>
                    </div>

                    <div class="col-12 mb-3">
                        <label asp-for="MapAddress"
                               class="form-label">Google Maps Address</label>
                        <input asp-for="MapAddress"
                               class="form-control"
                               placeholder="Rajkot, Gujarat, India" />
                        <small class="text-muted">
                            Enter the location you want to display on the map.
                        </small>
                    </div>

                    <div class="col-12 mb-3">
                        <label asp-for="WorkingHours"
                               class="form-label">Working Hours</label>
                        <input asp-for="WorkingHours"
                               class="form-control" />
                    </div>

                </div>

                <hr />

                <h5 class="mb-3">Social Media Links</h5>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="Facebook"
                               class="form-label">Facebook URL</label>
                        <input asp-for="Facebook"
                               class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Instagram"
                               class="form-label">Instagram URL</label>
                        <input asp-for="Instagram"
                               class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Twitter"
                               class="form-label">Twitter / X URL</label>
                        <input asp-for="Twitter"
                               class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="LinkedIn"
                               class="form-label">LinkedIn URL</label>
                        <input asp-for="LinkedIn"
                               class="form-control" />
                    </div>

                    <div class="col-12 mb-3">
                        <label asp-for="Description"
                               class="form-label">Description</label>
                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="4"></textarea>
                    </div>

                </div>

                <div class="d-flex gap-2 mt-3">

                    <button type="submit" class="btn btn-success px-4">
                        <i class="bi bi-save"></i>
                        Save Changes
                    </button>

                    <a href="/Contact"
                       target="_blank"
                       class="btn btn-outline-primary">
                        Preview Contact Page
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}