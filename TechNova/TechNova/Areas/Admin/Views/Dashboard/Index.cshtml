@model DashboardViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h3 mb-1">Dashboard overview</h1>
        <p class="text-muted mb-0">Store performance at a glance</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card metric-card metric-primary h-100"><div class="card-body">
            <div class="metric-icon"><i class="bi bi-bag-check"></i></div>
            <div class="metric-label">Total orders</div><div class="metric-value">@Model.TotalOrders</div>
        </div></div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card metric-card metric-success h-100"><div class="card-body">
            <div class="metric-icon"><i class="bi bi-currency-exchange"></i></div>
            <div class="metric-label">Paid revenue</div><div class="metric-value">Rs @Model.TotalRevenue.ToString("N0")</div>
        </div></div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card metric-card metric-info h-100"><div class="card-body">
            <div class="metric-icon"><i class="bi bi-phone"></i></div>
            <div class="metric-label">Products</div><div class="metric-value">@Model.TotalProducts</div>
        </div></div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card metric-card metric-purple h-100"><div class="card-body">
            <div class="metric-icon"><i class="bi bi-people"></i></div>
            <div class="metric-label">Customers</div><div class="metric-value">@Model.TotalCustomers</div>
        </div></div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6">
        <div class="card alert-metric border-warning h-100"><div class="card-body d-flex align-items-center gap-3">
            <i class="bi bi-clock-history text-warning fs-2"></i>
            <div><div class="metric-label">Pending orders</div><div class="metric-value">@Model.PendingOrders</div></div>
        </div></div>
    </div>
    <div class="col-sm-6">
        <div class="card alert-metric border-danger h-100"><div class="card-body d-flex align-items-center gap-3">
            <i class="bi bi-exclamation-triangle text-danger fs-2"></i>
            <div><div class="metric-label">Low-stock products</div><div class="metric-value">@Model.LowStockProducts</div></div>
        </div></div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-xl-8">
        <section class="card dashboard-card h-100">
            <div class="card-header"><h2 class="h6 mb-0"><i class="bi bi-graph-up me-2"></i>Monthly sales</h2></div>
            <div class="card-body chart-container"><canvas id="salesChart" aria-label="Monthly sales and order totals" role="img"></canvas></div>
        </section>
    </div>
    <div class="col-xl-4">
        <section class="card dashboard-card h-100">
            <div class="card-header"><h2 class="h6 mb-0"><i class="bi bi-trophy me-2"></i>Top products</h2></div>
            <div class="card-body chart-container"><canvas id="topProductsChart" aria-label="Top products by revenue" role="img"></canvas></div>
        </section>
    </div>
</div>

<div class="row g-3">
    <div class="col-xl-8">
        <section class="card dashboard-card h-100">
            <div class="card-header"><h2 class="h6 mb-0"><i class="bi bi-clock-history me-2"></i>Recent orders</h2></div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead><tr><th>Order</th><th>Customer</th><th>Amount</th><th>Status</th><th>Date</th></tr></thead>
                    <tbody>
                        @if (Model.RecentOrders.Count == 0)
                        {
                            <tr><td class="text-center text-muted py-4" colspan="5">No orders yet.</td></tr>
                        }
                        else
                        {
                            @foreach (var order in Model.RecentOrders)
                            {
                                var badgeClass = order.Status switch
                                {
                                    "Pending" => "text-bg-warning",
                                    "Processing" => "text-bg-info",
                                    "Shipped" => "text-bg-primary",
                                    "Delivered" => "text-bg-success",
                                    "Cancelled" or "Refunded" => "text-bg-danger",
                                    _ => "text-bg-secondary"
                                };
                                <tr>
                                    <td class="fw-semibold">@order.OrderNumber</td>
                                    <td>@order.CustomerName</td>
                                    <td>Rs @order.TotalAmount.ToString("N0")</td>
                                    <td><span class="badge @badgeClass">@order.Status</span></td>
                                    <td>@order.OrderDate.ToString("MMM dd, HH:mm")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
    <div class="col-xl-4">
        <section class="card dashboard-card h-100">
            <div class="card-header"><h2 class="h6 mb-0"><i class="bi bi-stars me-2"></i>Top-selling products</h2></div>
            <div class="list-group list-group-flush">
                @if (Model.TopProducts.Count == 0)
                {
                    <div class="list-group-item text-muted py-4">No product sales yet.</div>
                }
                else
                {
                    @foreach (var product in Model.TopProducts)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center gap-3">
                            <div><div class="fw-semibold">@product.ProductName</div><small class="text-muted">@product.UnitsSold units sold</small></div>
                            <span class="badge text-bg-success">Rs @product.Revenue.ToString("N0")</span>
                        </div>
                    }
                }
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    <script>
        const monthlyLabels = @Html.Raw(JsonSerializer.Serialize(Model.MonthlySales.Select(item => item.Month)));
        const monthlySales = @Html.Raw(JsonSerializer.Serialize(Model.MonthlySales.Select(item => item.Sales)));
        const monthlyOrders = @Html.Raw(JsonSerializer.Serialize(Model.MonthlySales.Select(item => item.Orders)));
        const productLabels = @Html.Raw(JsonSerializer.Serialize(Model.TopProducts.Select(item => item.ProductName)));
        const productRevenue = @Html.Raw(JsonSerializer.Serialize(Model.TopProducts.Select(item => item.Revenue)));

        new Chart(document.getElementById('salesChart'), {
            type: 'line',
            data: {
                labels: monthlyLabels,
                datasets: [
                    { label: 'Sales (Rs)', data: monthlySales, borderColor: '#218c74', backgroundColor: 'rgba(33, 140, 116, 0.14)', tension: 0.35, fill: true, yAxisID: 'sales' },
                    { label: 'Orders', data: monthlyOrders, borderColor: '#4e73df', backgroundColor: 'rgba(78, 115, 223, 0.12)', tension: 0.35, yAxisID: 'orders' }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                scales: {
                    sales: { type: 'linear', position: 'left', title: { display: true, text: 'Sales (Rs)' } },
                    orders: { type: 'linear', position: 'right', title: { display: true, text: 'Orders' }, grid: { drawOnChartArea: false }, ticks: { precision: 0 } }
                }
            }
        });

        new Chart(document.getElementById('topProductsChart'), {
            type: 'doughnut',
            data: {
                labels: productLabels,
                datasets: [{ data: productRevenue, backgroundColor: ['#4e73df', '#1cc88a', '#36b9cc', '#f6c23e', '#e74a3b'] }]
            },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
        });
    </script>
}
