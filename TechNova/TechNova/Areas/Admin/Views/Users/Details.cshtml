@model ApplicationUser
@{
    ViewData["Title"] = $"User: {Model.FullName}";
    var userRoles = ViewBag.Roles as IEnumerable<string> ?? Enumerable.Empty<string>();
    var availableRoles = ViewBag.AvailableRoles as IEnumerable<string> ?? Enumerable.Empty<string>();
    var orders = ViewBag.Orders as IEnumerable<Order> ?? Enumerable.Empty<Order>();
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h3 mb-1"><i class="bi bi-person me-2"></i>@Model.FullName</h1>
        <p class="text-muted mb-0">User account details and access management.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back to users</a>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <section class="card dashboard-card mb-4">
            <div class="card-header"><h2 class="h5 mb-0">User information</h2></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">User ID</dt>
                    <dd class="col-sm-7"><code class="small text-break">@Model.Id</code></dd>
                    <dt class="col-sm-5">Email</dt>
                    <dd class="col-sm-7">@(Model.Email ?? "—")</dd>
                    <dt class="col-sm-5">Phone</dt>
                    <dd class="col-sm-7">@(Model.PhoneNumber ?? "—")</dd>
                    <dt class="col-sm-5">Date of birth</dt>
                    <dd class="col-sm-7">@(Model.DateOfBirth?.ToString("MMM dd, yyyy") ?? "—")</dd>
                    <dt class="col-sm-5">Joined</dt>
                    <dd class="col-sm-7">@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</dd>
                    <dt class="col-sm-5">Status</dt>
                    <dd class="col-sm-7"><span class="badge @(Model.IsActive ? "text-bg-success" : "text-bg-secondary")">@(Model.IsActive ? "Active" : "Inactive")</span></dd>
                </dl>
            </div>
        </section>

        <section class="card dashboard-card">
            <div class="card-header"><h2 class="h5 mb-0">Roles</h2></div>
            <div class="card-body">
                @if (!userRoles.Any())
                {
                    <p class="text-muted">No roles assigned.</p>
                }
                else
                {
                    @foreach (var role in userRoles)
                    {
                        <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                            <span class="badge text-bg-primary">@role</span>
                            <form asp-action="UpdateRole" method="post">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="role" value="@role" />
                                <input type="hidden" name="add" value="false" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                            </form>
                        </div>
                    }
                }

                @if (availableRoles.Any())
                {
                    <hr />
                    <form asp-action="UpdateRole" method="post" class="d-flex gap-2">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="add" value="true" />
                        <select name="role" class="form-select form-select-sm" aria-label="Role to add">
                            @foreach (var role in availableRoles)
                            {
                                <option value="@role">@role</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-sm btn-success">Add</button>
                    </form>
                }
            </div>
        </section>
    </div>

    <div class="col-lg-4">
        <section class="card dashboard-card">
            <div class="card-header"><h2 class="h5 mb-0">Address</h2></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Address</dt>
                    <dd class="col-sm-7">@(Model.Address ?? "—")</dd>
                    <dt class="col-sm-5">City</dt>
                    <dd class="col-sm-7">@(Model.City ?? "—")</dd>
                    <dt class="col-sm-5">Postal code</dt>
                    <dd class="col-sm-7">@(Model.PostalCode ?? "—")</dd>
                    <dt class="col-sm-5">Country</dt>
                    <dd class="col-sm-7">@(Model.Country ?? "—")</dd>
                </dl>
            </div>
        </section>
    </div>

    <div class="col-lg-4">
        <section class="card dashboard-card mb-4">
            <div class="card-header"><h2 class="h5 mb-0">Recent orders</h2></div>
            <div class="card-body p-0">
                @if (!orders.Any())
                {
                    <p class="text-muted p-3 mb-0">No orders yet.</p>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var order in orders)
                        {
                            var statusClass = order.Status switch
                            {
                                OrderStatus.Pending => "text-bg-warning",
                                OrderStatus.Processing => "text-bg-info",
                                OrderStatus.Shipped => "text-bg-primary",
                                OrderStatus.Delivered => "text-bg-success",
                                OrderStatus.Cancelled => "text-bg-danger",
                                _ => "text-bg-secondary"
                            };
                            <div class="list-group-item d-flex justify-content-between align-items-center gap-2">
                                <div>
                                    <strong>@order.OrderNumber</strong>
                                    <br /><small class="text-muted">@order.OrderDate.ToString("MMM dd, yyyy")</small>
                                </div>
                                <span class="badge @statusClass">@order.Status</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </section>

        <section class="card dashboard-card">
            <div class="card-header"><h2 class="h5 mb-0">Actions</h2></div>
            <div class="card-body">
                <form asp-action="ToggleStatus" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn @(Model.IsActive ? "btn-warning" : "btn-success") w-100">
                        <i class="bi @(Model.IsActive ? "bi-pause-circle" : "bi-play-circle") me-1"></i>
                        @(Model.IsActive ? "Deactivate user" : "Activate user")
                    </button>
                </form>
            </div>
        </section>
    </div>
</div>
